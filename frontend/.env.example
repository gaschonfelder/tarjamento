# Base das chamadas à API, do ponto de vista do BROWSER.
# Default "/api": o browser fala com a própria origem e o Vite repassa.
# Só mude se houver um proxy reverso servindo front e API na mesma origem.
# Apontar direto para http://127.0.0.1:8731 NÃO funciona: a API não tem CORS.
VITE_API_URL=/api

# Para onde o proxy do dev server aponta (lado servidor, sem CORS envolvido).
VITE_API_TARGET=http://127.0.0.1:8731
